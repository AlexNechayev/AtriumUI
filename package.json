{
  "name": "atrium-ui",
  "version": "0.5.4",
  "description": "AtriumUI - a production-grade custom component library and design system for Home Assistant (Lovelace).",
  "type": "module",
  "license": "MIT",
  "author": "Alex Nechayev",
  "homepage": "https://github.com/AlexNechayev/AtriumUI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexNechayev/AtriumUI.git"
  },
  "bugs": {
    "url": "https://github.com/AlexNechayev/AtriumUI/issues"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "lit",
    "design-system"
  ],
  "main": "dist/atrium-ui.js",
  "module": "dist/atrium-ui.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "hacs.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "dev:ha": "HA_BUILD=1 vite build --watch --outDir \"${HA_WWW:-/Volumes/config/www/atrium-ui}\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.28.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
